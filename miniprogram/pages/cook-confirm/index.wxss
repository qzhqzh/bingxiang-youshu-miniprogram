.cook-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:28rpx; }.eyebrow { margin-bottom:8rpx; color:#24564A; font-size:22rpx; }.servings { display:flex; align-items:center; gap:16rpx; white-space:nowrap; }.servings button { width:58rpx; height:58rpx; line-height:58rpx; margin:0; padding:0; border:0; border-radius:14rpx; background:#EEF2EA; color:#24564A; }.servings button::after { border:0; }.fefo-note { display:flex; align-items:center; gap:16rpx; margin-top:20rpx; padding:20rpx; border-radius:18rpx; background:#F7EBDC; }.fefo-note image { width:48rpx; height:48rpx; }.fefo-note text { display:block; color:#775A37; font-size:23rpx; }.fefo-note text+text { margin-top:5rpx; color:#91785C; font-size:20rpx; }.match { font-size:23rpx; }.match.ready { color:#24564A; }.match.short { color:#D96B62; }.consume { margin-bottom:16rpx; padding:24rpx; }.consume-head { display:flex; align-items:center; gap:16rpx; }.consume-head image { width:58rpx; height:58rpx; }.consume-name { flex:1; display:flex; align-items:center; gap:10rpx; font-weight:600; }.optional { padding:4rpx 10rpx; border-radius:99rpx; background:#EEEDEA; color:#777; font-size:19rpx; }.numbers { color:#24564A; font-size:24rpx; }.numbers.short { color:#D96B62; }.batch-allocation { margin-top:16rpx; padding:14rpx 16rpx; border-radius:14rpx; background:#F8F6F1; }.batch-allocation view { display:flex; justify-content:space-between; margin:7rpx 0; color:#6B756F; font-size:22rpx; }.no-stock { margin-top:14rpx; color:#B0625B; font-size:22rpx; }.missing-btn { margin-top:24rpx; }.commit-note { margin-top:24rpx; color:#777F79; font-size:21rpx; line-height:1.7; text-align:center; }
