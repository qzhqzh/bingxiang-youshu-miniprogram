.hero { position:relative; overflow:hidden; padding:34rpx; border:1rpx solid #D8E3D9; background:linear-gradient(145deg,#DFEBE2,#F7E8D5); }.hero::after { content:""; position:absolute; width:210rpx; height:210rpx; right:-70rpx; bottom:-100rpx; border:34rpx solid rgba(255,255,255,.28); border-radius:50%; }.brand-lockup { position:relative; z-index:1; display:flex; align-items:center; gap:12rpx; margin-bottom:16rpx; color:#24564A; font-size:23rpx; font-weight:650; letter-spacing:2rpx; }.brand-lockup image { width:42rpx; height:42rpx; border-radius:12rpx; }.hero .page-title,.stats,.hero-actions { position:relative; z-index:1; }.stats { display:flex; align-items:center; gap:36rpx; margin-top:34rpx; }.stats>view { display:flex; align-items:baseline; gap:12rpx; }.stat-number { font-size:50rpx; font-weight:750; }.stat-number.accent { color:#D88335; }.stat-label { color:#627169; font-size:23rpx; }.stat-line { width:1rpx; height:42rpx; background:#BFD0C2; }.hero-actions { display:flex; gap:16rpx; margin-top:30rpx; }.hero-btn { flex:1; height:72rpx; line-height:72rpx; margin:0; border:0; border-radius:18rpx; background:rgba(255,254,250,.86); color:#345D52; font-size:25rpx; font-weight:600; }.hero-btn::after { border:0; }.hero-btn.primary { background:#24564A; color:white; }.priority-scroll { width:100%; }.priority-card { display:inline-block; width:260rpx; margin-right:18rpx; padding:24rpx; vertical-align:top; }.priority-icon { display:block; width:86rpx; height:86rpx; margin-bottom:18rpx; }.priority-name { margin-top:16rpx; font-size:30rpx; font-weight:650; }.priority-quantity,.priority-advice { margin-top:8rpx; font-size:23rpx; color:#6B756F; }.priority-advice { color:#B36C28; }.recipe-card { margin-bottom:18rpx; padding:26rpx; }.recipe-top { display:flex; justify-content:space-between; gap:20rpx; }.recipe-name { font-size:30rpx; font-weight:650; }.recipe-meta,.missing { margin-top:10rpx; color:#6B756F; font-size:23rpx; }.recipe-action { height:48rpx; padding:0 16rpx; border-radius:999rpx; background:#F7E2CD; color:#A85E1F; font-size:22rpx; line-height:48rpx; white-space:nowrap; }.recipe-action.ready { background:#DFECE2; color:#24564A; }.match-line { display:flex; align-items:center; gap:16rpx; margin-top:20rpx; color:#6B756F; font-size:22rpx; }.match-track { flex:1; height:10rpx; border-radius:99rpx; background:#E8E5DC; overflow:hidden; }.match-fill { height:100%; border-radius:99rpx; background:#7FAE8B; }.retry { margin-top:20rpx; }
