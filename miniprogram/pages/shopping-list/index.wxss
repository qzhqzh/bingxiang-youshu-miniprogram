.manual { display:flex; align-items:center; gap:12rpx; margin-top:28rpx; padding:16rpx; }.manual picker { flex:1.4; min-width:0; }.select,.manual input { height:66rpx; padding:0 16rpx; border-radius:12rpx; background:#F7F4EE; font-size:23rpx; line-height:66rpx; }.manual input { flex:1; min-width:0; }.manual button { flex:none; height:66rpx; line-height:66rpx; margin:0; padding:0 20rpx; border:0; border-radius:12rpx; background:#24564A; color:white; font-size:23rpx; }.manual button::after { border:0; }.shopping-list { margin-top:26rpx; }.shopping-card { display:flex; align-items:center; gap:16rpx; margin-bottom:16rpx; padding:22rpx; }.shopping-card.checked { opacity:.58; }.shopping-card.checked .name { text-decoration:line-through; }.check { display:flex; align-items:center; justify-content:center; width:42rpx; height:42rpx; border:2rpx solid #99A498; border-radius:50%; color:#fff; background:#fff; font-size:23rpx; }.checked .check { border-color:#24564A; background:#24564A; }.shopping-card image { width:58rpx; height:58rpx; }.shopping-main { flex:1; min-width:0; }.name { font-size:28rpx; font-weight:600; }.meta { margin-top:7rpx; color:#6B756F; font-size:21rpx; }.actions { display:flex; flex-direction:column; align-items:center; gap:10rpx; }.actions button { height:54rpx; line-height:54rpx; margin:0; padding:0 15rpx; border:0; border-radius:12rpx; background:#F7E2CD; color:#9C6228; font-size:21rpx; }.actions button::after { border:0; }.actions text { color:#999; font-size:20rpx; }
