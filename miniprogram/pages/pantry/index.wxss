.filter-scroll { margin-top:30rpx; }.category-scroll { margin-top:16rpx; }.chip-row.small .chip { height:54rpx; padding:0 20rpx; font-size:23rpx; }.pantry-list { margin-top:26rpx; }.pantry-card { display:flex; align-items:center; gap:20rpx; margin-bottom:18rpx; padding:24rpx; }.pantry-main { flex:1; min-width:0; }.name-row { display:flex; align-items:center; flex-wrap:wrap; gap:12rpx; }.name { font-size:31rpx; font-weight:650; }.quantity { margin-top:12rpx; font-size:26rpx; }.meta { margin-top:8rpx; color:#6B756F; font-size:22rpx; }.quick-actions { display:flex; flex-direction:column; gap:8rpx; }.quick-actions button { flex:none; height:54rpx; line-height:54rpx; margin:0; padding:0 16rpx; border:0; border-radius:13rpx; font-size:22rpx; }.quick-actions button::after { border:0; }.use { background:#E8F1E6; color:#24564A; }.restock { background:#F5EEE3; color:#9D672B; }
