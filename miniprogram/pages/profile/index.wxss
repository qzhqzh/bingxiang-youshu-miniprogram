.profile-head { display:flex; align-items:center; gap:22rpx; padding:20rpx; border-radius:28rpx; background:linear-gradient(135deg,#E4EEE6,#F7E8D6); }.profile-head image { width:104rpx; height:104rpx; border-radius:26rpx; box-shadow:0 8rpx 20rpx rgba(36,86,74,.13); }.stats { display:flex; justify-content:space-around; margin-top:30rpx; padding:30rpx 12rpx; }.stats view { flex:1; display:flex; flex-direction:column; align-items:center; gap:8rpx; border-right:1rpx solid #E7DFD2; }.stats view:last-child { border:0; }.stats>view>text:first-child { font-size:41rpx; font-weight:700; color:#24564A; }.stats .stat-label { color:#6B756F; font-size:21rpx; font-weight:400; }.settings { margin-top:18rpx; overflow:hidden; }.setting-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:112rpx; padding:20rpx 24rpx; }.setting-row>view:first-child { display:flex; flex-direction:column; gap:7rpx; }.setting-row>view:first-child>text:first-child { font-size:27rpx; }.setting-row .setting-label { color:#818782; font-size:21rpx; }.value { color:#4D6A61; font-size:23rpx; white-space:nowrap; }.danger-row>view:first-child>text:first-child,.danger-row .value { color:#B55B54; }.privacy-card { display:flex; flex-direction:column; gap:8rpx; margin-top:28rpx; padding:22rpx 24rpx; color:#6B756F; font-size:22rpx; line-height:1.55; }.privacy-title { color:#24564A; font-size:25rpx; font-weight:650; }.about { display:flex; flex-direction:column; align-items:center; gap:8rpx; margin-top:42rpx; color:#858C87; font-size:20rpx; text-align:center; line-height:1.5; }.about image { width:76rpx; height:76rpx; margin-bottom:4rpx; border-radius:20rpx; opacity:.9; }
