.detail-page { padding-top:0; }.recipe-hero { margin:0 -28rpx; padding:24rpx 36rpx 38rpx; background:linear-gradient(180deg,#E9F1E7,#FAF7F2); text-align:center; }.cover { display:flex; align-items:center; justify-content:center; width:154rpx; height:154rpx; margin:0 auto 18rpx; border-radius:44rpx; background:#fff; }.cover image { width:104rpx; height:104rpx; }.status { display:inline-block; padding:7rpx 18rpx; border-radius:999rpx; background:#EEEDEA; color:#71766F; font-size:22rpx; }.status.mastered { background:#DFECE2; color:#24564A; }.status.unlockable { background:#F7E2CD; color:#A4621F; }.recipe-hero .page-title { margin-top:15rpx; }.metrics { display:flex; justify-content:space-around; margin-top:30rpx; }.metrics view { display:flex; flex-direction:column; gap:6rpx; }.metrics b { font-size:31rpx; }.metrics span { color:#6B756F; font-size:21rpx; }.unlock-btn { display:flex; align-items:center; justify-content:center; gap:14rpx; height:82rpx; margin:20rpx 0; border:0; border-radius:18rpx; background:#F7E2CD; color:#9E6125; font-size:27rpx; }.unlock-btn::after { border:0; }.unlock-btn image { width:46rpx; height:46rpx; }.locked-note { margin-top:20rpx; padding:24rpx; border-radius:18rpx; background:#EEEDEA; color:#6B756F; font-size:24rpx; }.ingredient-list { overflow:hidden; }.ingredient-row { display:flex; align-items:center; gap:18rpx; padding:22rpx 24rpx; border-bottom:1rpx solid #EFE8DE; }.ingredient-row:last-child { border:0; }.ingredient-row image { width:58rpx; height:58rpx; }.ingredient-name { flex:1; display:flex; align-items:center; gap:10rpx; }.optional { padding:4rpx 10rpx; border-radius:999rpx; background:#EEEDEA; color:#777; font-size:19rpx; }.amount { display:flex; flex-direction:column; align-items:flex-end; gap:5rpx; font-size:24rpx; }.available { font-size:20rpx; }.available.enough { color:#5E8B61; }.available.short { color:#D96B62; }.step { display:flex; gap:20rpx; margin-top:16rpx; padding:24rpx; }.step-number { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; border-radius:50%; background:#24564A; color:white; font-size:23rpx; }.step-content { flex:1; line-height:1.65; }.duration { display:block; margin-top:6rpx; color:#A66B2A; font-size:22rpx; }.caution-card { margin-top:16rpx; padding:24rpx; border-radius:20rpx; background:#FFF0DC; color:#8A612F; font-size:24rpx; line-height:1.9; }
.metrics text { color:#6B756F; font-size:21rpx; }.metrics .metric-value { color:#183B33; font-size:31rpx; font-weight:700; }
.substitution { margin-top:16rpx; padding:24rpx; }.substitution>view { display:flex; align-items:center; gap:14rpx; font-weight:600; }.swap { color:#24564A; }.sub-note { display:block; margin-top:10rpx; color:#6B756F; font-size:22rpx; line-height:1.5; }.retry { margin-top:18rpx; }
.available.optional-missing { color:#8A8E8A; }
