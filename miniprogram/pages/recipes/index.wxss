.search-box { display:flex; align-items:center; gap:14rpx; margin-top:26rpx; padding:0 22rpx; height:82rpx; border:1rpx solid #DED5C7; border-radius:22rpx; background:#FFFEFA; color:#728078; }.search-box input { flex:1; height:82rpx; font-size:25rpx; }.clear-search { padding:12rpx; font-size:32rpx; }.filters { margin-top:20rpx; }.recipe-list { margin-top:26rpx; }.recipe-card { margin-bottom:20rpx; padding:26rpx; }.card-head { display:flex; gap:20rpx; }.recipe-icon { display:flex; align-items:center; justify-content:center; width:78rpx; height:78rpx; border-radius:20rpx; background:#F7E2CD; font-size:38rpx; }.recipe-main { flex:1; }.name-row { display:flex; align-items:center; justify-content:space-between; gap:14rpx; }.name-actions { display:flex; align-items:center; gap:8rpx; }.name { font-size:31rpx; font-weight:650; }.status { padding:7rpx 14rpx; border-radius:999rpx; background:#EEEDEA; color:#71766F; font-size:21rpx; }.status.mastered { background:#DFECE2; color:#24564A; }.status.unlockable { background:#F7E2CD; color:#A4621F; }.favorite { width:58rpx; height:58rpx; line-height:54rpx; margin:0; padding:0; border:0; background:transparent; color:#9A9F9B; font-size:36rpx; }.favorite::after { border:0; }.favorite.active { color:#E7A05B; }.description { margin-top:8rpx; color:#6B756F; font-size:23rpx; }.metrics { display:flex; gap:30rpx; margin-top:22rpx; color:#6B756F; font-size:22rpx; }.match-track { height:10rpx; margin-top:18rpx; border-radius:99rpx; background:#ECEAE4; overflow:hidden; }.match-fill { height:100%; background:#7FAE8B; }.footer { display:flex; justify-content:space-between; align-items:center; margin-top:14rpx; }.missing { color:#A56822; font-size:23rpx; }.missing.ready { color:#24564A; }.arrow { color:#9CA39D; font-size:36rpx; }
