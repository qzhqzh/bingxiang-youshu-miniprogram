.filters { margin-top:30rpx; }.recipe-list { margin-top:26rpx; }.recipe-card { margin-bottom:20rpx; padding:26rpx; }.card-head { display:flex; gap:20rpx; }.recipe-icon { display:flex; align-items:center; justify-content:center; width:78rpx; height:78rpx; border-radius:20rpx; background:#F7E2CD; font-size:38rpx; }.recipe-main { flex:1; }.name-row { display:flex; align-items:center; justify-content:space-between; gap:14rpx; }.name { font-size:31rpx; font-weight:650; }.status { padding:7rpx 14rpx; border-radius:999rpx; background:#EEEDEA; color:#71766F; font-size:21rpx; }.status.mastered { background:#DFECE2; color:#24564A; }.status.unlockable { background:#F7E2CD; color:#A4621F; }.description { margin-top:8rpx; color:#6B756F; font-size:23rpx; }.metrics { display:flex; gap:30rpx; margin-top:22rpx; color:#6B756F; font-size:22rpx; }.match-track { height:10rpx; margin-top:18rpx; border-radius:99rpx; background:#ECEAE4; overflow:hidden; }.match-fill { height:100%; background:#7FAE8B; }.footer { display:flex; justify-content:space-between; align-items:center; margin-top:14rpx; }.missing { color:#A56822; font-size:23rpx; }.missing.ready { color:#24564A; }.arrow { color:#9CA39D; font-size:36rpx; }
