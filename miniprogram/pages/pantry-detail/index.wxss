.ingredient-hero { display:flex; align-items:center; gap:28rpx; padding:30rpx; }.hero-icon { width:112rpx; height:112rpx; }.total { margin-top:10rpx; color:#6B756F; font-size:25rpx; }.batch-card { position:relative; margin-top:20rpx; padding:26rpx; }.batch-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }.batch-date { font-size:27rpx; font-weight:600; }.storage { margin-left:14rpx; color:#6B756F; font-size:22rpx; }.batch-quantity { margin-top:24rpx; font-size:34rpx; font-weight:700; }.fresh-meta { margin-top:10rpx; color:#6B756F; font-size:23rpx; line-height:1.5; }.progress { height:12rpx; margin-top:18rpx; border-radius:99rpx; background:#EEECE7; overflow:hidden; }.progress-fill { height:100%; background:#24564A; }.progress-fill.good { background:#9AA364; }.progress-fill.useSoon { background:#E8B04A; }.progress-fill.overdue { background:#D96B62; }.note { margin-top:16rpx; padding:14rpx; border-radius:12rpx; background:#F8F5F0; color:#6B756F; font-size:23rpx; }.discard { height:58rpx; line-height:58rpx; margin:20rpx 0 0 auto; padding:0 18rpx; border:0; background:transparent; color:#A7645E; font-size:23rpx; }.discard::after { border:0; }.safety-note { margin-top:30rpx; padding:22rpx; border-radius:18rpx; background:#F3EDE4; color:#777066; font-size:22rpx; line-height:1.6; }
