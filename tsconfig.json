{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "lib": ["ES2020"],
    "typeRoots": ["./miniprogram/typings"]
  },
  "include": ["miniprogram/**/*.ts"]
}
