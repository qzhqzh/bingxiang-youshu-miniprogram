{
  "name": "bingxiang-youshu-miniprogram",
  "version": "1.2.0",
  "private": true,
  "description": "冰箱有数——家庭食材库存、新鲜度提醒与食谱匹配微信小程序",
  "keywords": [
    "wechat-miniprogram",
    "typescript",
    "food-inventory",
    "recipe",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/qzhqzh/bingxiang-youshu-miniprogram.git"
  },
  "homepage": "https://github.com/qzhqzh/bingxiang-youshu-miniprogram#readme",
  "bugs": {
    "url": "https://github.com/qzhqzh/bingxiang-youshu-miniprogram/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/static-check.mjs",
    "release:check": "node scripts/static-check.mjs && node scripts/release-check.mjs",
    "release:check:placeholder": "node scripts/static-check.mjs && node scripts/release-check.mjs --allow-placeholder"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
